{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mamada Reproductor",
  "version": "1.0.0",
  "identifier": "com.gonzalo.mamada-reproductor",
  "build": {
    "beforeDevCommand": "cd .. && npm run web",
    "beforeBuildCommand": "cd .. && npm run export:web",
    "devUrl": "http://localhost:8083",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mamada Reproductor",
        "width": 520,
        "height": 720,
        "minWidth": 420,
        "minHeight": 600,
        "maxWidth": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}