# Solo serviria para un flujo server-to-server (client_credentials); la app
# usa Authorization Code + PKCE y no lo necesita. Se deja por si hace falta a futuro.
TIDAL_CLIENT_SECRET=tu_client_secret_aqui

# Version publica del client id: esta SI se embebe en el bundle de la app (no es secreta).
EXPO_PUBLIC_TIDAL_CLIENT_ID=tu_client_id_aqui
